# ── Secrets — NEVER commit API keys or credentials ───────────────────────────
# The system reads all keys from environment variables (on the VM, from GCP
# Secret Manager). These patterns are a safety net so a local key file can
# never be committed by accident.
.env
.env.*
*.key
*-key.txt
*_key.txt
gemini-api-key*
secrets/
service-account*.json
*service_account*.json
storage_state.json
credentials.json

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
venv/

# ── Episode audio ────────────────────────────────────────────────────────────
# Downloaded episodes are transient: the durable copies are the GitHub Release
# assets (mirrored to Drive), and the pipeline deletes the local file at the end
# of each run. They must never enter git — a single week is ~600 MB, and NOTHING
# removes a blob from history once committed.
podcasts/
*.mp3
*.m4a
